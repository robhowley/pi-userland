{
  "name": "@robhowley/pi-openrouter",
  "version": "0.14.3",
  "type": "module",
  "description": "Live OpenRouter spend/account TUI overlays, user-scoped or free-only model sync, api key management, and session tagging for Pi.",
  "license": "MIT",
  "files": [
    "extensions",
    "README.md",
    "../LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "pi-package",
    "openrouter",
    "pi-userland"
  ],
  "pi": {
    "extensions": [
      "./extensions/openrouter"
    ],
    "image": "https://raw.githubusercontent.com/robhowley/pi-userland/main/packages/pi-openrouter/img/openrouter-usage-tui.png"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/robhowley/pi-userland.git",
    "directory": "packages/pi-openrouter"
  },
  "homepage": "https://github.com/robhowley/pi-userland/blob/main/packages/pi-openrouter/README.md",
  "scripts": {
    "lint": "eslint extensions/",
    "format:check": "prettier --check extensions/",
    "format:write": "prettier --write extensions/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run __tests__"
  },
  "dependencies": {
    "@mariozechner/pi-tui": "*",
    "@openrouter/sdk": "^0.13.13"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.84.4",
    "@earendil-works/pi-coding-agent": ">=0.84.4"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.84.4",
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@mariozechner/pi-coding-agent": "*",
    "@types/node": "^22.15.17"
  }
}
