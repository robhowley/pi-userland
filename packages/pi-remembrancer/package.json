{
  "name": "@robhowley/pi-remembrancer",
  "version": "0.5.0",
  "type": "module",
  "description": "Track and review commitments across Pi sessions to keep your personal Taskwarrior list current.",
  "engines": {
    "node": ">=22.13.0"
  },
  "files": [
    "extensions",
    "skills/remembrancer",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "pi-package",
    "pi-userland",
    "taskwarrior",
    "todo"
  ],
  "pi": {
    "extensions": [
      "./extensions/remembrancer"
    ],
    "skills": [
      "./skills/remembrancer"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/robhowley/pi-userland.git",
    "directory": "packages/pi-remembrancer"
  },
  "homepage": "https://github.com/robhowley/pi-userland/blob/main/packages/pi-remembrancer/README.md",
  "scripts": {
    "lint": "eslint extensions/ __tests__/",
    "format:check": "prettier --check extensions/ __tests__/",
    "format:write": "prettier --write extensions/ __tests__/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run __tests__"
  },
  "license": "MIT",
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@types/node": "^22.15.17"
  }
}
